---
// Lógica de servidor de Astro
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OBSIDIAN STORE</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Libertinus+Serif:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&display=swap" rel="stylesheet">
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Libertinus Serif', sans-serif;
            background-color: #050505;
            color: #ffffff;
            overflow-x: hidden;
        }

        .split-screen-container {
            display: flex;
            height: 100vh;
            width: 100%;
        }

        .split-section {
            flex: 1;
            position: relative;
            display: flex;
            align-items: flex-end;
            justify-content: center;
            overflow: hidden;
            text-decoration: none;
            cursor: pointer;
            color: #ffffff;
        }

        .split-image {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 1;
            filter: brightness(0.6) contrast(1.1);
            transition: transform 0.5s ease;
        }

        .split-section:hover .split-image {
            transform: scale(1.05);
        }

        .split-content {
            position: relative;
            z-index: 2;
            text-align: center;
            padding-bottom: 80px;
            text-shadow: 2px 2px 10px rgba(0,0,0,0.8);
        }

        .split-content h2 {
            font-size: 60px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 10px;
        }

        .split-content p {
            font-size: 18px;
            font-weight: 500;
            color: #a3a3a3;
            text-transform: uppercase;
            letter-spacing: 3px;
        }

        .brand-logo-container {
            position: absolute;
            top: 30px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 10;
            text-align: center;
        }
        
        .brand-logo-container h1 {
            font-size: 30px;
            font-weight: 900;
            letter-spacing: 4px;
        }
        
        .brand-logo-container span {
            color: #a3a3a3;
        }

        @media (max-width: 768px) {
            .split-screen-container {
                flex-direction: column;
            }
            .split-section {
                height: 50vh;
            }
            .split-content h2 {
                font-size: 40px;
            }
        }
    </style>
</head>
<body>

    <!-- LOGO PRINCIPAL -->
    <div class="brand-logo-container">
        <h1>OBSIDIAN <span>STORE</span></h1>
    </div>

    <!-- CONTENEDOR DE LA PANTALLA DIVIDIDA -->
    <div class="split-screen-container">
        
<!-- SECCIÓN 1: PANTALONES -->
<a href="/pantalones" class="split-section">
    <img class="split-image" src="/pantalones.jpg" alt="Colección de Pantalones">
    <div class="split-content">
        <h2>PANTALONES</h2>
        <p>Ver Catálogo</p>
    </div>
</a>
        <!-- SECCIÓN 2: HOODIES Y CAMISETAS -->
        <!-- Nota cómo el enlace ya apunta a /camisetas -->
        <a href="/camisetas" class="split-section">
            <img class="split-image" src="/camisetas.jpeg" alt="Colección de Camisetas y Hoodies">
            <div class="split-content">
                <h2>HOODIES & CAMISETAS</h2>
                <p>Ver Catálogo</p>
            </div>
        </a>

    </div>

</body>
</html>