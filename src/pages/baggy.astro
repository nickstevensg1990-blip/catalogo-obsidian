---
// Lógica de servidor de Astro
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Baggy Pants - OBSIDIAN STORE</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Libertinus+Serif&display=swap" rel="stylesheet">
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Libertinus Serif', serif;
            background-image: url('/Lily.jpg'); 
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            color: #ffffff;
            padding: 50px 20px;
            text-align: center;
        }

        h1 {
            font-size: 45px;
            margin-bottom: 50px;
            letter-spacing: 3px;
            text-shadow: 2px 2px 8px rgba(0,0,0,0.8); 
        }

        /* --- CUADRÍCULA ESTRICTA DE 50/50 --- */
        .catalogo-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr)); 
            gap: 40px;
            max-width: 1000px; 
            margin: 0 auto;
            width: 100%;
        }

        @media (max-width: 768px) {
            .catalogo-grid {
                grid-template-columns: 1fr;
            }
        }

        /* --- DISEÑO DE LAS TARJETAS --- */
        .producto {
            background-color: #ffffff;
            color: #050505; 
            padding: 20px;
            border-radius: 10px;
            transition: transform 0.3s ease;
            box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.3);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            width: 100%; 
        }

        .producto:hover {
            transform: translateY(-5px);
        }

        .producto > img {
            width: 100%;
            height: 350px;
            object-fit: contain; 
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .producto h3 {
            font-size: 22px;
            margin-bottom: 10px;
        }

        .producto p.precio {
            color: #555555;
            font-size: 18px;
            margin-bottom: 15px;
            font-weight: bold;
        }

        /* --- SELECTOR DE TALLA --- */
        .selector-talla {
            margin-bottom: 20px;
            font-weight: bold;
            font-size: 18px;
            min-height: 34px; 
        }

        .selector-talla select {
            padding: 5px 15px;
            font-size: 16px;
            border: 2px solid #050505;
            border-radius: 5px;
            background-color: #ffffff;
            color: #050505;
            font-family: inherit;
            font-weight: bold;
            cursor: pointer;
            margin-left: 10px;
            outline: none;
            transition: background 0.3s;
        }

        .selector-talla select:hover {
            background-color: #f0f0f0;
        }

        .mensaje-talla {
            font-size: 16px;
            font-weight: normal;
            color: #777;
            font-style: italic;
        }

        /* --- BOTÓN DE WHATSAPP --- */
        .btn-whatsapp {
            display: inline-block;
            background-color: #050505;
            color: #ffffff;
            padding: 12px 25px;
            text-decoration: none;
            font-weight: bold;
            border-radius: 30px;
            transition: background 0.3s;
            width: 100%;
            margin-top: auto;
        }

        .btn-whatsapp:hover {
            background-color: #333333;
        }
    </style>
</head>
<body>

    <h1>BAGGY PANTS</h1>

    <div class="catalogo-grid">
        
        <!-- PRODUCTO 1: Baggy Barrel Gris -->
        <div class="producto">
            <img src="/baggygrisbarrel.jpeg" alt="Baggy Barrel Gris">
            <h3>Baggy Barrel Gris</h3>
            <p class="precio">$27.00</p>
            <div class="selector-talla">
                <span class="mensaje-talla">Consultar talla por WhatsApp</span>
            </div>
            <a href="#" id="btn-barrelgris" target="_blank" class="btn-whatsapp">Comprar por WhatsApp</a>
        </div>

        <!-- PRODUCTO 2: Baggy Barrel Cafe -->
        <div class="producto">
            <img src="/baggybarrelcafe.jpeg" alt="Baggy Barrel Cafe">
            <h3>Baggy Barrel Cafe</h3>
            <p class="precio">$27.00</p>
            <div class="selector-talla">
                <span class="mensaje-talla">Consultar talla por WhatsApp</span>
            </div>
            <a href="#" id="btn-barrelcafe" target="_blank" class="btn-whatsapp">Comprar por WhatsApp</a>
        </div>

        <!-- PRODUCTO 3: Baggy Barrel Gris Exclusivo -->
        <div class="producto">
            <img src="/baggybarrelgris.jpeg" alt="Baggy Barrel Gris Exclusivo">
            <h3>Baggy Barrel Gris Exclusivo</h3>
            <p class="precio">$27.00</p>
            <div class="selector-talla">
                <span class="mensaje-talla">Consultar talla por WhatsApp</span>
            </div>
            <a href="#" id="btn-barrelexclusivo" target="_blank" class="btn-whatsapp">Comprar por WhatsApp</a>
        </div>

        <!-- PRODUCTO 4: Baggy Skate Gris -->
        <div class="producto">
            <img src="/baggyskategris.jpeg" alt="Baggy Skate Gris">
            <h3>Baggy Skate Gris</h3>
            <p class="precio">$27.00</p>
            <div class="selector-talla">
                <span class="mensaje-talla">Consultar talla por WhatsApp</span>
            </div>
            <a href="#" id="btn-skategris" target="_blank" class="btn-whatsapp">Comprar por WhatsApp</a>
        </div>

        <!-- PRODUCTO 5: Baggy Skate Camo -->
        <div class="producto">
            <img src="/baggyskatecamo.jpeg" alt="Baggy Skate Camo">
            <h3>Baggy Skate Camo</h3>
            <p class="precio">$27.00</p>
            <div class="selector-talla">
                <span class="mensaje-talla">Consultar talla por WhatsApp</span>
            </div>
            <a href="#" id="btn-skatecamo" target="_blank" class="btn-whatsapp">Comprar por WhatsApp</a>
        </div>

        <!-- PRODUCTO 6: Baggy Skate -->
        <div class="producto">
            <img src="/baggyskate.jpeg" alt="Baggy Skate">
            <h3>Baggy Skate</h3>
            <p class="precio">$27.00</p>
            <div class="selector-talla">
                <span class="mensaje-talla">Consultar talla por WhatsApp</span>
            </div>
            <a href="#" id="btn-skate" target="_blank" class="btn-whatsapp">Comprar por WhatsApp</a>
        </div>

        <!-- PRODUCTO 7: Super Baggy Negro -->
        <div class="producto">
            <img src="/superbaggy.jpeg" alt="Super Baggy Negro">
            <h3>Super Baggy Negro</h3>
            <p class="precio">$27.00</p>
            <div class="selector-talla">
                <label for="talla-super">Talla:</label>
                <select id="talla-super" onchange="actualizarWhatsApp('talla-super', 'btn-super', 'Super Baggy Negro')">
                    <option value="30 (Última unidad)">30 (Última unidad)</option>
                </select>
            </div>
            <a href="#" id="btn-super" target="_blank" class="btn-whatsapp">Comprar por WhatsApp</a>
        </div>

        <!-- PRODUCTO 8: Baggy Rayos Oscuro (Anterior) -->
        <div class="producto">
            <img src="/laser3.png" alt="Baggy Rayos Oscuro">
            <h3>Baggy Rayos Oscuro</h3>
            <p class="precio">$22.00</p>
            <div class="selector-talla">
                <label for="talla-rayososcuro">Talla:</label>
                <select id="talla-rayososcuro" onchange="actualizarWhatsApp('talla-rayososcuro', 'btn-rayososcuro', 'Baggy Rayos Oscuro')">
                    <option value="32">32</option>
                </select>
            </div>
            <a href="#" id="btn-rayososcuro" target="_blank" class="btn-whatsapp">Comprar por WhatsApp</a>
        </div>

        <!-- PRODUCTO 9: Baggy Premium (Anterior) -->
        <div class="producto">
            <img src="/baggypeluche.png" alt="Baggy Premium">
            <h3>Baggy Premium</h3>
            <p class="precio">$26.00</p>
            <div class="selector-talla">
                <label for="talla-premium">Talla:</label>
                <select id="talla-premium" onchange="actualizarWhatsApp('talla-premium', 'btn-premium', 'Baggy Premium')">
                    <option value="32">32</option>
                    <option value="34">34</option>
                </select>
            </div>
            <a href="#" id="btn-premium" target="_blank" class="btn-whatsapp">Comprar por WhatsApp</a>
        </div>

    </div>

    <!-- SCRIPT DE WHATSAPP INTELIGENTE -->
    <script is:inline>
        const numeroObsidian = "593962596100"; 

        // Función original para los que tienen selector de talla
        function actualizarWhatsApp(idSelect, idBoton, nombreProducto) {
            const select = document.getElementById(idSelect);
            const tallaElegida = select.value;
            const mensajeFinal = "Hola, quiero comprar el pantalón " + nombreProducto + " en talla " + tallaElegida;
            const enlaceCompleto = "https://wa.me/" + numeroObsidian + "?text=" + encodeURIComponent(mensajeFinal);
            document.getElementById(idBoton).href = enlaceCompleto;
        }

        // Nueva función para los que no tienen selector de talla (deja espacio para escribir)
        function configurarWhatsAppSinTalla(idBoton, nombreProducto) {
            const mensajeFinal = "Hola, me interesa el " + nombreProducto + ". Quisiera saber la disponibilidad en talla: [ESCRIBE TU TALLA AQUÍ]";
            const enlaceCompleto = "https://wa.me/" + numeroObsidian + "?text=" + encodeURIComponent(mensajeFinal);
            document.getElementById(idBoton).href = enlaceCompleto;
        }

        window.onload = function() {
            // Inicializar productos sin selector (Los nuevos primeros)
            configurarWhatsAppSinTalla('btn-barrelgris', 'Baggy Barrel Gris');
            configurarWhatsAppSinTalla('btn-barrelcafe', 'Baggy Barrel Cafe');
            configurarWhatsAppSinTalla('btn-barrelexclusivo', 'Baggy Barrel Gris Exclusivo');
            configurarWhatsAppSinTalla('btn-skategris', 'Baggy Skate Gris');
            configurarWhatsAppSinTalla('btn-skatecamo', 'Baggy Skate Camo');
            configurarWhatsAppSinTalla('btn-skate', 'Baggy Skate');

            // Inicializar productos con selector
            actualizarWhatsApp('talla-super', 'btn-super', 'Super Baggy Negro');
            actualizarWhatsApp('talla-rayososcuro', 'btn-rayososcuro', 'Baggy Rayos Oscuro');
            actualizarWhatsApp('talla-premium', 'btn-premium', 'Baggy Premium');
        };
    </script>
</body>
</html>