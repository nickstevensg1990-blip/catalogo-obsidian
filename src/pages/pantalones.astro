---
// Lógica de servidor de Astro
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cortes de Pantalón - OBSIDIAN STORE</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Libertinus+Serif:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&display=swap" rel="stylesheet">
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Libertinus Serif', sans-serif;
            background-color: #050505;
            color: #ffffff;
            overflow-x: hidden;
        }

        /* Título de la página */
        .header-seccion {
            text-align: center;
            padding: 40px 20px;
        }

        .header-seccion h1 {
            font-size: 45px;
            letter-spacing: 3px;
            margin-bottom: 10px;
        }

        .header-seccion p {
            color: #a3a3a3;
            font-size: 18px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        /* Cuadrícula de categorías */
        .categorias-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            min-height: 75vh; 
            width: 100%;
        }

        /* Estilo base de cada bloque */
        .categoria-item {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            text-decoration: none;
            color: #ffffff;
            border: 2px solid #050505; 
            min-height: 35vh; 
        }

        /* MAGIA CSS: Hace que la sección de Bermudas ocupe las 2 columnas */
        .categoria-destacada {
            grid-column: span 2;
        }

        .categoria-img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: contain; /* <-- LA SOLUCIÓN: Hace que la imagen encaje completa sin recortarse */
            background-color: #ffffff; /* <-- Añadido para rellenar los espacios vacíos y que no se vea el fondo negro */
            z-index: 1;
            filter: brightness(0.5) contrast(1.1); 
            transition: transform 0.5s ease, filter 0.5s ease;
        }

        .categoria-item:hover .categoria-img {
            transform: scale(1.05);
            filter: brightness(0.8) contrast(1.1); 
        }

        .categoria-texto {
            position: relative;
            z-index: 2;
            text-align: center;
            text-shadow: 2px 2px 10px rgba(0,0,0,0.9);
        }

        .categoria-texto h2 {
            font-size: 50px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 3px;
        }

        /* Diseño para celulares */
        @media (max-width: 768px) {
            .categorias-grid {
                grid-template-columns: 1fr;
            }
            .categoria-item {
                height: 30vh; 
            }
            .categoria-destacada {
                grid-column: span 1; 
            }
            .categoria-texto h2 {
                font-size: 40px;
            }
        }
    </style>
</head>
<body>

    <div class="header-seccion">
        <h1>PANTALONES</h1>
        <p>Selecciona tu corte</p>
    </div>

    <div class="categorias-grid">
        
        <!-- OPCIÓN 1: BAGGY -->
        <a href="/baggy" class="categoria-item">
            <img class="categoria-img" src="/baggy.jpg" alt="Pantalones Baggy">
            <div class="categoria-texto">
                <h2>BAGGY</h2>
            </div>
        </a>

        <!-- OPCIÓN 2: FLARED -->
       <a href="/flared" class="categoria-item">
            <img class="categoria-img" src="/flared.jpg" alt="Pantalones Flared">
            <div class="categoria-texto">
                <h2>FLARED</h2>
            </div>
        </a>

        <!-- OPCIÓN 3: RECTO -->
        <a href="/recto" class="categoria-item">
            <img class="categoria-img" src="/recto.jpg" alt="Pantalones Rectos">
            <div class="categoria-texto">
                <h2>RECTO</h2>
            </div>
        </a>

        <!-- OPCIÓN 4: MOM JEAN -->
        <a href="/momjean" class="categoria-item">
            <img class="categoria-img" src="/monjean.jpg" alt="Mom Jeans">
            <div class="categoria-texto">
                <h2>MOM JEAN</h2>
            </div>
        </a>

        <!-- OPCIÓN 5: BERMUDAS -->
        <a href="/bermudas" class="categoria-item categoria-destacada">
            <img class="categoria-img" src="/bermudas.jpg" alt="Bermudas">
            <div class="categoria-texto">
                <h2>BERMUDAS</h2>
            </div>
        </a>

    </div>

</body>
</html>