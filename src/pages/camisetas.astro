    <script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    
    <script is:inline>
        const NUMERO_WHATSAPP = "593962596100";
        let tipoActivo = "";
        let nombreSlideActivo = "";
        let precioSlideActivo = "";

        // Variable talla directa (Outfit 4: Beisbolera)
        let tallaPrincipalSeleccionada = "M";

        // Variables Outfit 1 (Hoodies)
        let materialSeleccionado = "100% Algodón";
        let precioHoodieSeleccionado = "$22.00";
        let colorHoodieSeleccionado = "Vino";
        let tallaHoodieSeleccionada = "M";

        const COLORES_HOODIE_100 = [
            { nombre: "Vino", hex: "#5c0a1e", img: "/vino.png", galeria: "" },
            { nombre: "Froggy Gray", hex: "#7d8a82", img: "/foggy.png", galeria: "" }
        ];

        const COLORES_HOODIE_65 = [
            { nombre: "Negro", hex: "#1a1a1a", img: "/negra.png", galeria: "/pose1.jpeg,/pose2.jpeg" },
            { nombre: "Rosado", hex: "#eebbce", img: "/hoddierosa.png", galeria: "" },
            { nombre: "Azul Eléctrico", hex: "#0044cc", img: "/hoddierosa.png", galeria: "" },
            { nombre: "Rojo", hex: "#aa0000", img: "/roja.png", galeria: "" },
            { nombre: "Gris", hex: "#8c8c8c", img: "/gris.png", galeria: "" }
        ];

        // Variables Outfit 2 (Zip Hoodies)
        let colorZipSeleccionado = "Gris";
        let tallaZipSeleccionada = "M";

        // Variables Outfit 3 (Camisetas Boxy Fit)
        let camisetaSeleccionada = "BOXY FIT 1";
        let tallaCamisetaSeleccionada = "M";

        // Variables Outfit 5 (Long Sleeve)
        let colorLongSeleccionado = "Rosado";
        let tallaLongSeleccionada = "M";

        const swiper = new Swiper(".mySwiper", {
            grabCursor: true,      
            centeredSlides: true,  
            slidesPerView: "auto", 
            loop: false,             
            spaceBetween: 10,        
            speed: 600,              
            on: {
                init: function () {
                    actualizarPanelDeCompras(this);
                },
                slideChange: function () {
                    actualizarPanelDeCompras(this);
                },
                touchStart: function () {
                    const aviso = document.getElementById('aviso-deslizar');
                    if (aviso) aviso.style.opacity = '0';
                }
            }
        });

        function actualizarPanelDeCompras(swiperInstance) {
            const slideActivo = swiperInstance.slides[swiperInstance.activeIndex];
            if (!slideActivo) return;

            nombreSlideActivo = slideActivo.getAttribute('data-nombre') || '';
            precioSlideActivo = slideActivo.getAttribute('data-precio') || '';
            const desc = slideActivo.getAttribute('data-desc') || '';
            const mockup = slideActivo.getAttribute('data-mockup') || ''; 
            tipoActivo = slideActivo.getAttribute('data-tipo') || '';
            const btnText = slideActivo.getAttribute('data-btn-text') || '';

            document.getElementById('panel-nombre').innerText = nombreSlideActivo;
            document.getElementById('panel-precio').innerText = precioSlideActivo;
            document.getElementById('panel-desc').innerText = desc;

            const mockupContainer = document.getElementById('panel-mockup-container');
            const mockupImg = document.getElementById('panel-mockup');
            const btnAbrirColores = document.getElementById('btn-abrir-colores');
            const bloqueTallasPrincipal = document.getElementById('bloque-tallas-principal');
            const btnComprarPrincipal = document.getElementById('btn-comprar-principal');

            if (mockup.trim() !== "") {
                mockupImg.src = mockup;
                mockupContainer.style.display = 'flex'; 
            } else {
                mockupImg.src = "";
                mockupContainer.style.display = 'none'; 
            }

            if (tipoActivo === 'directo') {
                bloqueTallasPrincipal.style.display = 'flex';
                btnAbrirColores.style.display = 'none';
                btnComprarPrincipal.innerText = 'COMPRAR BEISBOLERA';
            } else if (tipoActivo !== "") {
                bloqueTallasPrincipal.style.display = 'none';
                btnAbrirColores.innerText = btnText;
                btnAbrirColores.style.display = 'block';
                btnComprarPrincipal.innerText = 'COMPRAR LOOK';
            } else {
                bloqueTallasPrincipal.style.display = 'none';
                btnAbrirColores.style.display = 'none';
                btnComprarPrincipal.innerText = 'COMPRAR LOOK';
            }
        }

        // Selección de talla directa en panel principal (Beisbolera)
        const botonesTallaPrincipal = document.querySelectorAll('.talla-principal-btn');
        botonesTallaPrincipal.forEach(btn => {
            btn.addEventListener('click', (e) => {
                botonesTallaPrincipal.forEach(b => b.classList.remove('activo'));
                e.target.classList.add('activo');
                tallaPrincipalSeleccionada = e.target.getAttribute('data-talla');
            });
        });

        // Botón comprar principal
        document.getElementById('btn-comprar-principal').addEventListener('click', (e) => {
            e.preventDefault();
            let mensaje = '';
            if (tipoActivo === 'directo') {
                mensaje = `Hola! Deseo la ${nombreSlideActivo} en talla ${tallaPrincipalSeleccionada} (${precioSlideActivo}).`;
            } else {
                mensaje = `Hola! Me interesa el look: ${nombreSlideActivo} (${precioSlideActivo}).`;
            }
            const url = `https://wa.me/${NUMERO_WHATSAPP}?text=${encodeURIComponent(mensaje)}`;
            window.open(url, '_blank');
        });

        function cargarGaleriaVertical(modeloSrc, galeriaStr) {
            const contenedor = document.getElementById('galeria-vertical');
            contenedor.innerHTML = '';
            contenedor.scrollTop = 0;

            const listaFotos = [];
            if (modeloSrc && modeloSrc.trim() !== '') {
                listaFotos.push(modeloSrc.trim());
            }
            if (galeriaStr && galeriaStr.trim() !== '') {
                galeriaStr.split(',').forEach(ruta => {
                    if (ruta.trim() !== '') listaFotos.push(ruta.trim());
                });
            }

            listaFotos.forEach((ruta, index) => {
                const item = document.createElement('div');
                item.className = 'foto-vertical-item';

                const img = document.createElement('img');
                img.src = ruta;
                img.alt = `Vista ${index + 1}`;
                item.appendChild(img);

                if (index === 0 && listaFotos.length > 1) {
                    const aviso = document.createElement('div');
                    aviso.className = 'aviso-subir';
                    aviso.innerText = '↑ DESLIZA HACIA ARRIBA';
                    item.appendChild(aviso);
                }

                contenedor.appendChild(item);
            });
        }

        function ocultarTodasLasSubvistas() {
            document.getElementById('vista-hoodie-colores').style.display = 'none';
            document.getElementById('vista-zip').style.display = 'none';
            document.getElementById('vista-camisetas').style.display = 'none';
            document.getElementById('vista-longsleeve').style.display = 'none';
        }

        function cerrarTodoYVolverAlCarrusel() {
            document.getElementById('modal-algodon').style.display = 'none';
            document.body.classList.remove('modo-colores');
            document.body.classList.remove('modo-hoodie-centrado');
            ocultarTodasLasSubvistas();
            swiper.allowTouchMove = true; 
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        document.getElementById('btn-abrir-colores').addEventListener('click', (e) => {
            e.preventDefault();

            if (tipoActivo === 'hoodie') {
                document.getElementById('modal-algodon').style.display = 'flex';
                swiper.allowTouchMove = false;
                if (window.location.hash !== '#calidad') {
                    history.pushState({ vista: 'calidad' }, '', '#calidad');
                }
            } else if (tipoActivo === 'zip') {
                document.body.classList.remove('modo-hoodie-centrado');
                document.body.classList.add('modo-colores');
                swiper.allowTouchMove = false;
                window.scrollTo({ top: 0, behavior: 'smooth' });

                if (window.location.hash !== '#colores') {
                    history.pushState({ vista: 'zip' }, '', '#colores');
                }

                ocultarTodasLasSubvistas();
                document.getElementById('vista-zip').style.display = 'flex';

                const btnActivo = document.querySelector('.color-zip-btn.activo');
                if (btnActivo) {
                    colorZipSeleccionado = btnActivo.getAttribute('data-color-nombre') || 'Gris';
                    cargarGaleriaVertical(
                        btnActivo.getAttribute('data-modelo'),
                        btnActivo.getAttribute('data-galeria')
                    );
                }
            } else if (tipoActivo === 'camiseta') {
                document.body.classList.remove('modo-hoodie-centrado');
                document.body.classList.add('modo-colores');
                swiper.allowTouchMove = false;
                window.scrollTo({ top: 0, behavior: 'smooth' });

                if (window.location.hash !== '#camisetas') {
                    history.pushState({ vista: 'camisetas' }, '', '#camisetas');
                }

                ocultarTodasLasSubvistas();
                document.getElementById('vista-camisetas').style.display = 'flex';
                cargarGaleriaVertical('/outfit3.png', '');
            } else if (tipoActivo === 'longsleeve') {
                document.body.classList.remove('modo-hoodie-centrado');
                document.body.classList.add('modo-colores');
                swiper.allowTouchMove = false;
                window.scrollTo({ top: 0, behavior: 'smooth' });

                if (window.location.hash !== '#longsleeve') {
                    history.pushState({ vista: 'longsleeve' }, '', '#longsleeve');
                }

                ocultarTodasLasSubvistas();
                document.getElementById('vista-longsleeve').style.display = 'flex';

                const btnActivo = document.querySelector('.color-long-btn.activo');
                if (btnActivo) {
                    colorLongSeleccionado = btnActivo.getAttribute('data-color-nombre') || 'Rosado';
                    document.getElementById('nombre-color-long').innerText = colorLongSeleccionado.toUpperCase();
                    cargarGaleriaVertical('', btnActivo.getAttribute('data-galeria'));
                }
            }
        });

        document.getElementById('btn-cerrar-modal-algodon').addEventListener('click', () => {
            if (window.location.hash === '#calidad') {
                history.back();
            } else {
                cerrarTodoYVolverAlCarrusel();
            }
        });

        // ==========================================
        // OUTFIT 1: HOODIES
        // ==========================================
        function aplicarColorHoodie(col, conAnimacion = true) {
            const previewImg = document.getElementById('mockup-hoodie-preview');
            colorHoodieSeleccionado = col.nombre;
            document.getElementById('nombre-color-hoodie').innerText = col.nombre.toUpperCase();

            if (conAnimacion) {
                previewImg.style.opacity = 0;
                setTimeout(() => {
                    previewImg.src = col.img;
                    previewImg.style.opacity = 1;
                }, 150);
            } else {
                previewImg.src = col.img;
            }

            if (col.galeria && col.galeria.trim() !== '') {
                document.body.classList.remove('modo-hoodie-centrado');
                cargarGaleriaVertical('', col.galeria);
            } else {
                document.body.classList.add('modo-hoodie-centrado');
                document.getElementById('galeria-vertical').innerHTML = '';
            }
        }

        function abrirColoresHoodie(calidad, precio, listaColores) {
            materialSeleccionado = calidad;
            precioHoodieSeleccionado = precio;

            document.getElementById('subtitulo-hoodie-calidad').innerText = calidad.toUpperCase();
            document.getElementById('precio-hoodie-panel').innerText = precio;

            const contenedorColores = document.getElementById('selector-colores-hoodie');
            contenedorColores.innerHTML = '';

            listaColores.forEach((col, index) => {
                const btn = document.createElement('button');
                btn.className = 'color-btn' + (index === 0 ? ' activo' : '');
                btn.style.backgroundColor = col.hex;
                btn.title = col.nombre;

                btn.addEventListener('click', () => {
                    contenedorColores.querySelectorAll('.color-btn').forEach(b => b.classList.remove('activo'));
                    btn.classList.add('activo');
                    aplicarColorHoodie(col, true);
                });

                contenedorColores.appendChild(btn);
            });

            document.getElementById('modal-algodon').style.display = 'none';
            document.body.classList.add('modo-colores');
            ocultarTodasLasSubvistas();
            document.getElementById('vista-hoodie-colores').style.display = 'flex';
            window.scrollTo({ top: 0, behavior: 'smooth' });

            if (listaColores.length > 0) {
                aplicarColorHoodie(listaColores[0], false);
            }

            if (window.location.hash !== '#colores-hoodie') {
                history.pushState({ vista: 'hoodie-colores' }, '', '#colores-hoodie');
            }
        }

        document.getElementById('btn-elegir-100').addEventListener('click', () => {
            abrirColoresHoodie("100% Algodón", "$22.00", COLORES_HOODIE_100);
        });

        document.getElementById('btn-elegir-65').addEventListener('click', () => {
            abrirColoresHoodie("65% Algodón", "$17.00", COLORES_HOODIE_65);
        });

        document.getElementById('btn-cambiar-calidad').addEventListener('click', () => {
            if (window.location.hash === '#colores-hoodie') {
                history.back();
            } else {
                document.body.classList.remove('modo-colores');
                document.body.classList.remove('modo-hoodie-centrado');
                ocultarTodasLasSubvistas();
                document.getElementById('modal-algodon').style.display = 'flex';
            }
        });

        const botonesTallaHoodie = document.querySelectorAll('.talla-hoodie-btn');
        botonesTallaHoodie.forEach(btn => {
            btn.addEventListener('click', (e) => {
                botonesTallaHoodie.forEach(b => b.classList.remove('activo'));
                e.target.classList.add('activo');
                tallaHoodieSeleccionada = e.target.getAttribute('data-talla');
            });
        });

        document.getElementById('btn-comprar-hoodie-ws').addEventListener('click', (e) => {
            e.preventDefault();
            const mensaje = `Hola! Deseo la Hoodie Murciélago (${materialSeleccionado} - ${precioHoodieSeleccionado}) color ${colorHoodieSeleccionado} en talla ${tallaHoodieSeleccionada}.`;
            const url = `https://wa.me/${NUMERO_WHATSAPP}?text=${encodeURIComponent(mensaje)}`;
            window.open(url, '_blank');
        });

        document.querySelectorAll('.btn-volver-carrusel').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                cerrarTodoYVolverAlCarrusel();
                if (window.location.hash) {
                    history.replaceState(null, '', window.location.pathname);
                }
            });
        });

        window.addEventListener('popstate', () => {
            if (window.location.hash === '#calidad' && tipoActivo === 'hoodie') {
                document.body.classList.remove('modo-colores');
                document.body.classList.remove('modo-hoodie-centrado');
                ocultarTodasLasSubvistas();
                document.getElementById('modal-algodon').style.display = 'flex';
            } else {
                cerrarTodoYVolverAlCarrusel();
            }
        });

        // ==========================================
        // OUTFIT 2: ZIP HOODIES
        // ==========================================
        const botonesColorZip = document.querySelectorAll('.color-zip-btn');
        const imgPreviewZip = document.getElementById('mockup-color-preview');

        botonesColorZip.forEach(btn => {
            btn.addEventListener('click', (e) => {
                botonesColorZip.forEach(b => b.classList.remove('activo'));
                e.target.classList.add('activo');
                
                colorZipSeleccionado = e.target.getAttribute('data-color-nombre') || 'Gris';
                const nuevaImg = e.target.getAttribute('data-img');
                const nuevoModelo = e.target.getAttribute('data-modelo'); 
                const nuevaGaleria = e.target.getAttribute('data-galeria');
                
                const slideActivo = document.querySelector('.swiper-slide-active');
                if (slideActivo) {
                    slideActivo.setAttribute('data-mockup', nuevaImg);
                    const imgModeloCarrusel = slideActivo.querySelector('img');
                    if (imgModeloCarrusel && nuevoModelo) {
                        imgModeloCarrusel.src = nuevoModelo;
                    }
                }

                imgPreviewZip.style.opacity = 0;
                setTimeout(() => {
                    imgPreviewZip.src = nuevaImg;
                    imgPreviewZip.style.opacity = 1;
                }, 150);

                cargarGaleriaVertical(nuevoModelo, nuevaGaleria);
            });
        });

        const botonesTallaZip = document.querySelectorAll('.talla-zip-btn');
        botonesTallaZip.forEach(btn => {
            btn.addEventListener('click', (e) => {
                botonesTallaZip.forEach(b => b.classList.remove('activo'));
                e.target.classList.add('activo');
                tallaZipSeleccionada = e.target.getAttribute('data-talla');
            });
        });

        document.getElementById('btn-comprar-whatsapp').addEventListener('click', (e) => {
            e.preventDefault();
            const mensaje = `Hola! Deseo la Zip Hoodie Murciélago color ${colorZipSeleccionado} en talla ${tallaZipSeleccionada} ($17.00).`;
            const url = `https://wa.me/${NUMERO_WHATSAPP}?text=${encodeURIComponent(mensaje)}`;
            window.open(url, '_blank');
        });

        // ==========================================
        // OUTFIT 3: CAMISETAS BOXY FIT
        // ==========================================
        const botonesModeloCamiseta = document.querySelectorAll('.modelo-btn');
        const imgPreviewCamiseta = document.getElementById('mockup-camiseta-preview');

        botonesModeloCamiseta.forEach(btn => {
            btn.addEventListener('click', (e) => {
                botonesModeloCamiseta.forEach(b => b.classList.remove('activo'));
                e.target.classList.add('activo');

                camisetaSeleccionada = e.target.getAttribute('data-titulo');
                const nuevaImg = e.target.getAttribute('data-img');

                document.getElementById('titulo-camiseta-activa').innerText = camisetaSeleccionada;

                imgPreviewCamiseta.style.opacity = 0;
                setTimeout(() => {
                    imgPreviewCamiseta.src = nuevaImg;
                    imgPreviewCamiseta.style.opacity = 1;
                }, 150);
            });
        });

        const botonesTallaCamiseta = document.querySelectorAll('.talla-camiseta-btn');
        botonesTallaCamiseta.forEach(btn => {
            btn.addEventListener('click', (e) => {
                botonesTallaCamiseta.forEach(b => b.classList.remove('activo'));
                e.target.classList.add('activo');
                tallaCamisetaSeleccionada = e.target.getAttribute('data-talla');
            });
        });

        document.getElementById('btn-comprar-camiseta-ws').addEventListener('click', (e) => {
            e.preventDefault();
            const mensaje = `Hola! Deseo la Camiseta ${camisetaSeleccionada} en talla ${tallaCamisetaSeleccionada} ($17.00).`;
            const url = `https://wa.me/${NUMERO_WHATSAPP}?text=${encodeURIComponent(mensaje)}`;
            window.open(url, '_blank');
        });

        // ==========================================
        // OUTFIT 5: LONG SLEEVE
        // ==========================================
        const botonesColorLong = document.querySelectorAll('.color-long-btn');
        const imgPreviewLong = document.getElementById('mockup-long-preview');

        botonesColorLong.forEach(btn => {
            btn.addEventListener('click', (e) => {
                botonesColorLong.forEach(b => b.classList.remove('activo'));
                e.target.classList.add('activo');

                colorLongSeleccionado = e.target.getAttribute('data-color-nombre') || 'Rosado';
                const nuevaImg = e.target.getAttribute('data-img');
                const nuevaGaleria = e.target.getAttribute('data-galeria');

                document.getElementById('nombre-color-long').innerText = colorLongSeleccionado.toUpperCase();

                const slideActivo = document.querySelector('.swiper-slide-active');
                if (slideActivo) {
                    slideActivo.setAttribute('data-mockup', nuevaImg);
                }

                imgPreviewLong.style.opacity = 0;
                setTimeout(() => {
                    imgPreviewLong.src = nuevaImg;
                    imgPreviewLong.style.opacity = 1;
                }, 150);

                cargarGaleriaVertical('', nuevaGaleria);
            });
        });

        const botonesTallaLong = document.querySelectorAll('.talla-long-btn');
        botonesTallaLong.forEach(btn => {
            btn.addEventListener('click', (e) => {
                botonesTallaLong.forEach(b => b.classList.remove('activo'));
                e.target.classList.add('activo');
                tallaLongSeleccionada = e.target.getAttribute('data-talla');
            });
        });

        document.getElementById('btn-comprar-long-ws').addEventListener('click', (e) => {
            e.preventDefault();
            const mensaje = `Hola! Deseo la Long Sleeve Boxy Fit color ${colorLongSeleccionado} en talla ${tallaLongSeleccionada} ($20.00).`;
            const url = `https://wa.me/${NUMERO_WHATSAPP}?text=${encodeURIComponent(mensaje)}`;
            window.open(url, '_blank');
        });
    </script>
</body>
</html>