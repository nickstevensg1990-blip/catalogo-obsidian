---
// Lógica de servidor de Astro
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OBSIDIAN STORE - LOOKS</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet">
    
    <!-- Librería CSS de Swiper -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    
    <style is:global>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        html, body {
            width: 100%;
            height: 100%;
            background-color: #000000; 
            font-family: sans-serif;
            overflow: hidden; 
            color: #f7f7f7; 
        }

        .video-fondo {
            position: fixed;
            inset: 0;
            width: 100vw;
            height: 100vh;
            object-fit: cover;
            z-index: 0; 
        }

        .overlay {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.4); 
            z-index: 1; 
        }

        .escaparate {
            position: fixed; 
            inset: 0;
            z-index: 10; 
            display: flex;
            align-items: center; 
            justify-content: space-between; 
            height: 100vh; 
            width: 100%;
            max-width: 1650px; 
            margin: 0 auto;
            padding: 20px 50px; 
            gap: 40px;
        }

        /* ================================
           MODO CENTRADO (SOLO CUANDO UN COLOR NO TIENE FOTOS)
           ================================ */
        body.modo-hoodie-centrado .escaparate {
            justify-content: center !important;
        }
        body.modo-hoodie-centrado .galeria-vertical,
        body.modo-hoodie-centrado .aviso-bajar-modelos {
            display: none !important;
        }

        /* ================================
           MODAL CENTRAL: ELECCIÓN DE ALGODÓN
           ================================ */
        .modal-algodon {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 100;
            background: rgba(0, 0, 0, 0.82);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            justify-content: center;
            align-items: center;
            padding: 20px;
            animation: aparecerSuave 0.25s ease;
        }

        @keyframes aparecerSuave {
            from { opacity: 0; transform: scale(0.97); }
            to { opacity: 1; transform: scale(1); }
        }

        .modal-algodon-contenido {
            width: 100%;
            max-width: 720px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 24px;
            text-align: center;
        }

        .modal-titulo-sub {
            font-size: 12px;
            letter-spacing: 3px;
            color: #60a5fa;
            text-transform: uppercase;
            font-weight: 700;
        }

        .modal-titulo {
            font-family: 'Anton', sans-serif;
            font-size: 40px;
            letter-spacing: 2px;
            color: #ffffff;
            text-transform: uppercase;
            line-height: 1.05;
        }

        .tarjetas-algodon {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 22px;
            width: 100%;
        }

        .tarjeta-calidad {
            appearance: none;
            -webkit-appearance: none;
            position: relative;
            background: linear-gradient(145deg, rgba(28, 28, 34, 0.95), rgba(12, 12, 16, 0.95));
            border: 1.5px solid rgba(255, 255, 255, 0.16);
            border-radius: 16px;
            padding: 28px 24px;
            color: #ffffff;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 14px;
            text-align: center;
            transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.65);
        }

        .tarjeta-calidad:hover {
            transform: translateY(-6px) scale(1.02);
            border-color: #60a5fa;
            box-shadow: 0 0 28px rgba(37, 99, 235, 0.55), 0 18px 40px rgba(0, 0, 0, 0.8);
        }

        .badge-calidad {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 5px 12px;
            border-radius: 20px;
            background: rgba(37, 99, 235, 0.2);
            color: #93c5fd;
            border: 1px solid rgba(96, 165, 250, 0.4);
        }

        .tarjeta-calidad.premium .badge-calidad {
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            border-color: rgba(255, 255, 255, 0.35);
        }

        .titulo-calidad {
            font-family: 'Anton', sans-serif;
            font-size: 32px;
            letter-spacing: 1.5px;
            color: #ffffff;
            line-height: 1;
        }

        .precio-calidad {
            font-family: 'Anton', sans-serif;
            font-size: 34px;
            color: #60a5fa;
            letter-spacing: 1px;
        }

        .preview-dots {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin: 2px 0;
        }

        .preview-dot {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            border: 1.5px solid rgba(255, 255, 255, 0.5);
        }

        .desc-calidad {
            font-size: 13px;
            color: #bbb;
            line-height: 1.4;
        }

        .cta-tarjeta {
            margin-top: 6px;
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            background: #ffffff;
            color: #111111;
            font-family: 'Anton', sans-serif;
            font-size: 15px;
            letter-spacing: 1.5px;
            transition: background 0.2s ease, color 0.2s ease;
        }

        .tarjeta-calidad:hover .cta-tarjeta {
            background: #2563eb;
            color: #ffffff;
        }

        .btn-cerrar-modal-algodon {
            appearance: none;
            -webkit-appearance: none;
            background: transparent;
            color: #aaa;
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 12px 28px;
            border-radius: 30px;
            font-family: 'Anton', sans-serif;
            font-size: 14px;
            letter-spacing: 1.5px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-cerrar-modal-algodon:hover {
            color: #fff;
            border-color: #fff;
            background: rgba(255, 255, 255, 0.08);
        }

        /* ================================
           ZONA IZQUIERDA: CARRUSEL HORIZONTAL
           ================================ */
        .swiper {
            flex: 1;
            min-width: 0;
            height: 88vh; 
            padding: 0; 
        }

        body.modo-colores .swiper {
            display: none;
        }
        
        .swiper-slide {
            width: 460px; 
            height: 100%; 
            display: flex;
            justify-content: center;
            align-items: center; 
            opacity: 1 !important; 
            transform: scale(0.75); 
            transform-origin: center center; 
            transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.4s ease; 
        }
        
        .swiper-slide-active {
            transform: scale(1); 
            z-index: 10; 
        }
        
        .swiper-slide img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: contain;
            object-position: center; 
            filter: drop-shadow(0px 25px 20px rgba(0,0,0,0.8));
            transition: opacity 0.3s ease; 
        }

        /* ================================
           ZONA IZQUIERDA: GALERÍA VERTICAL (MODO ENFOQUE)
           ================================ */
        .galeria-vertical {
            display: none;
            flex: 1;
            min-width: 0;
            height: 88vh;
            overflow-y: auto;
            overflow-x: hidden;
            scroll-snap-type: y mandatory;
            scroll-behavior: smooth;
            scrollbar-width: none;
            position: relative;
        }

        .galeria-vertical::-webkit-scrollbar {
            display: none;
        }

        body.modo-colores .galeria-vertical {
            display: block;
        }

        .foto-vertical-item {
            width: 100%;
            height: 88vh;
            scroll-snap-align: start;
            scroll-snap-stop: always;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            padding: 15px;
        }

        .foto-vertical-item img {
            max-width: 85%;
            max-height: 80vh;
            width: auto;
            height: auto;
            object-fit: contain;
            border-radius: 12px;
            filter: drop-shadow(0px 20px 25px rgba(0, 0, 0, 0.85));
        }

        .aviso-subir {
            position: absolute;
            bottom: 12px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.7);
            color: #fff;
            font-family: 'Anton', sans-serif;
            font-size: 12px;
            letter-spacing: 2px;
            padding: 6px 16px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.25);
            pointer-events: none;
            animation: flotarArriba 1.8s infinite ease-in-out;
        }

        @keyframes flotarArriba {
            0%, 100% { transform: translate(-50%, 0); }
            50% { transform: translate(-50%, -6px); }
        }

        /* AVISO PARPADEANTE SOLO PARA MÓVIL DEBAJO DEL MENÚ */
        .aviso-bajar-modelos {
            display: none;
            text-align: center;
            background: #2563eb;
            color: #ffffff;
            font-family: 'Anton', sans-serif;
            font-size: 14px;
            letter-spacing: 1.5px;
            padding: 12px 20px;
            border-radius: 30px;
            border: 2px solid #93c5fd;
            animation: parpadearLlamativo 1.1s infinite ease-in-out;
        }

        @keyframes parpadearLlamativo {
            0%, 100% {
                opacity: 1;
                transform: translateY(0) scale(1);
                box-shadow: 0 0 20px rgba(37, 99, 235, 0.95), 0 0 8px rgba(255, 255, 255, 0.7);
            }
            50% {
                opacity: 0.3;
                transform: translateY(5px) scale(0.97);
                box-shadow: 0 0 4px rgba(37, 99, 235, 0.2);
            }
        }

        /* ================================
           ZONA DERECHA: PANEL DE COMPRA
           ================================ */
        .panel-lateral {
            width: 340px; 
            max-height: 92vh;
            overflow-y: auto;
            scrollbar-width: none;
            flex-shrink: 0; 
            background: rgba(15, 15, 15, 0.68); 
            backdrop-filter: blur(8px); 
            border: 1px solid rgba(255, 255, 255, 0.12); 
            padding: 20px 24px; 
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8); 
        }

        .panel-lateral::-webkit-scrollbar {
            display: none;
        }

        .vista-principal { display: flex; flex-direction: column; gap: 10px; }
        .vista-colores { display: none; flex-direction: column; gap: 9px; }
        
        body.modo-colores .vista-principal { display: none; }
        
        .panel-encabezado { margin-bottom: 0px; }

        .etiqueta-in-look {
            font-size: 11px;
            color: #aaa; 
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 4px;
            display: block;
        }

        .nombre-outfit {
            font-family: 'Anton', sans-serif;
            font-size: 26px; 
            color: #fff; 
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 2px;
            line-height: 1.05;
        }
        
        .precio-outfit {
            font-size: 22px;
            font-family: 'Anton', sans-serif;
            color: #f7f7f7; 
            letter-spacing: 1px;
        }

        .nombre-color-activo {
            text-align: center;
            font-size: 13px;
            color: #ddd;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            font-family: 'Anton', sans-serif;
        }

        /* ================================
           CAJA DEL MOCKUP (FONDO BLANCO FORZADO)
           ================================ */
        .contenedor-mockup {
            width: 100%;
            height: 145px; 
            background-color: #ffffff !important; 
            border-radius: 8px;
            padding: 10px;
            display: flex; 
            justify-content: center;
            align-items: center;
            margin-bottom: 2px;
            overflow: hidden; 
        }
        
        .contenedor-mockup img {
            width: 100%;
            height: 100%; 
            object-fit: contain; 
            filter: drop-shadow(0px 5px 8px rgba(0,0,0,0.3));
            transition: opacity 0.2s ease;
        }
        
        .desc-outfit {
            font-size: 14px;
            color: #ddd; 
            line-height: 1.4;
            font-weight: 300;
        }

        /* ================================
           BOTONES, COLORES, MODELOS Y TALLAS
           ================================ */
        .btn-comprar {
            appearance: none;
            -webkit-appearance: none;
            margin-top: 4px;
            background: #f7f7f7; 
            color: #111; 
            border: none;
            padding: 13px;
            font-family: 'Anton', sans-serif;
            font-size: 17px;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.3s ease;
            border-radius: 4px;
            text-align: center;
            text-decoration: none;
        }
        .btn-comprar:hover { transform: translateY(-2px); box-shadow: 0 8px 18px rgba(255, 255, 255, 0.2); }

        .btn-secundario {
            appearance: none;
            -webkit-appearance: none;
            background: rgba(0, 0, 0, 0.5); 
            color: #f7f7f7; 
            border: 1px solid #555;
            padding: 11px;
            font-family: 'Anton', sans-serif;
            font-size: 13px;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.3s ease;
            border-radius: 4px;
            text-align: center;
            text-decoration: none;
        }
        .btn-secundario:hover { background: #333; border-color: #f7f7f7; }

        .selector-colores {
            display: flex;
            justify-content: center;
            gap: 14px;
            margin: 2px 0;
            flex-wrap: wrap;
        }

        .color-btn {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 2px solid #444;
            cursor: pointer;
            transition: transform 0.2s, border-color 0.2s;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
        }
        .color-btn:hover, .color-btn.activo {
            transform: scale(1.2);
            border-color: #fff; 
        }

        /* SELECTOR DE MODELOS (BOXY FIT 1 / BOXY FIT 2) - ESTILO PREMIUM */
        .selector-modelos {
            display: flex;
            gap: 8px;
            padding: 5px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 10px;
            margin: 6px 0;
        }

        .modelo-btn {
            appearance: none;
            -webkit-appearance: none;
            flex: 1;
            padding: 11px 8px;
            background: transparent;
            color: #aaa;
            border: 1px solid transparent;
            border-radius: 7px;
            font-family: 'Anton', sans-serif;
            font-size: 15px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .modelo-btn:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.08);
        }

        .modelo-btn.activo {
            background: #2563eb;
            color: #ffffff;
            border-color: #60a5fa;
            box-shadow: 0 0 16px rgba(37, 99, 235, 0.75);
        }

        /* SELECTOR DE TALLAS (S, M, L) */
        .bloque-tallas {
            display: flex;
            flex-direction: column;
            gap: 5px;
            margin-top: 2px;
        }

        .etiqueta-talla {
            font-size: 11px;
            color: #aaa;
            letter-spacing: 2px;
            text-transform: uppercase;
            text-align: center;
        }

        .selector-tallas {
            display: flex;
            justify-content: center;
            gap: 10px;
        }

        .talla-btn {
            appearance: none;
            -webkit-appearance: none;
            flex: 1;
            padding: 9px 0;
            background: rgba(255, 255, 255, 0.06);
            color: #ddd;
            border: 1px solid #555;
            border-radius: 6px;
            font-family: 'Anton', sans-serif;
            font-size: 15px;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .talla-btn:hover {
            border-color: #fff;
            color: #fff;
        }

        .talla-btn.activo {
            background: #2563eb;
            color: #ffffff;
            border-color: #60a5fa;
            box-shadow: 0 0 15px rgba(37, 99, 235, 0.7);
            transform: scale(1.06);
        }

        /* ================================
           INDICADOR DE DESLIZAMIENTO (SOLO MÓVIL)
           ================================ */
        .indicador-swipe {
            display: none; 
            position: absolute;
            top: 45%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 20;
            pointer-events: none; 
            color: #fff;
            font-family: 'Anton', sans-serif;
            font-size: 13px;
            letter-spacing: 2px;
            background: rgba(0, 0, 0, 0.55);
            padding: 8px 20px;
            border-radius: 30px;
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255, 255, 255, 0.25);
            transition: opacity 0.5s ease;
            animation: moverLadoLado 2s infinite ease-in-out;
        }

        @keyframes moverLadoLado {
            0%, 100% { transform: translate(-55%, -50%); }
            50% { transform: translate(-45%, -50%); }
        }

        /* ================================
           MÓVILES
           ================================ */
        @media (max-width: 900px) {
            html, body {
                overflow-y: auto !important;
                overflow-x: hidden;
                height: auto !important;
            }
            .escaparate {
                position: relative;
                inset: auto;
                flex-direction: column;
                justify-content: flex-start;
                align-items: center;
                height: auto !important;
                min-height: 100vh;
                padding: 20px 16px 60px;
                gap: 18px;
            }
            .swiper { width: 100%; height: 60vh; flex: none; }
            .swiper-slide { width: 320px; }
            .panel-lateral { width: 100%; max-width: 400px; max-height: none; overflow: visible; }
            .indicador-swipe { display: block; }

            .modal-algodon {
                overflow-y: auto;
                align-items: center;
            }
            .modal-titulo {
                font-size: 28px;
            }
            .tarjetas-algodon {
                grid-template-columns: 1fr;
                gap: 14px;
            }
            .tarjeta-calidad {
                padding: 20px 18px;
                gap: 10px;
            }
            .titulo-calidad, .precio-calidad {
                font-size: 26px;
            }

            body.modo-colores .panel-lateral {
                order: 1;
            }
            body.modo-colores .aviso-bajar-modelos {
                display: block !important;
                order: 2;
                width: 100%;
                max-width: 400px;
            }
            body.modo-colores .galeria-vertical {
                display: flex !important;
                flex-direction: column;
                gap: 18px;
                order: 3;
                flex: none !important;
                width: 100%;
                max-width: 400px;
                height: auto !important;
                overflow: visible !important;
                scroll-snap-type: none;
            }
            body.modo-colores .foto-vertical-item {
                width: 100%;
                height: auto !important;
                padding: 0;
            }
            body.modo-colores .foto-vertical-item img {
                width: 100%;
                max-width: 100%;
                height: auto;
                max-height: 75vh;
                object-fit: contain;
                display: block;
            }
            body.modo-colores .aviso-subir {
                display: none;
            }

            body.modo-hoodie-centrado .escaparate {
                justify-content: center !important;
                padding-bottom: 20px;
            }
            body.modo-hoodie-centrado .galeria-vertical,
            body.modo-hoodie-centrado .aviso-bajar-modelos {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <video autoplay loop muted playsinline class="video-fondo">
        <source src="/estrellas.mp4" type="video/mp4">
    </video>
    <div class="overlay"></div>

    <!-- MODAL CENTRAL LLAMATIVO PARA ELEGIR ALGODÓN (OUTFIT 1) -->
    <div class="modal-algodon" id="modal-algodon">
        <div class="modal-algodon-contenido">
            <div>
                <div class="modal-titulo-sub">HOODIE MURCIÉLAGO • OBSIDIAN</div>
                <h2 class="modal-titulo">ELIGE LA CALIDAD DE ALGODÓN</h2>
            </div>

            <div class="tarjetas-algodon">
                <!-- OPCIÓN 100% ALGODÓN -->
                <button class="tarjeta-calidad premium" id="btn-elegir-100">
                    <span class="badge-calidad">EDICIÓN HEAVYWEIGHT</span>
                    <div class="titulo-calidad">100% ALGODÓN</div>
                    <div class="precio-calidad">$22.00</div>
                    <div class="preview-dots">
                        <span class="preview-dot" style="background: #5c0a1e;" title="Vino"></span>
                        <span class="preview-dot" style="background: #7d8a82;" title="Froggy Gray"></span>
                    </div>
                    <p class="desc-calidad">Colores exclusivos: Vino y Froggy Gray.</p>
                    <div class="cta-tarjeta">VER COLORES</div>
                </button>

                <!-- OPCIÓN 65% ALGODÓN -->
                <button class="tarjeta-calidad" id="btn-elegir-65">
                    <span class="badge-calidad">MÁS VARIEDAD</span>
                    <div class="titulo-calidad">65% ALGODÓN</div>
                    <div class="precio-calidad">$17.00</div>
                    <div class="preview-dots">
                        <span class="preview-dot" style="background: #1a1a1a;"></span>
                        <span class="preview-dot" style="background: #eebbce;"></span>
                        <span class="preview-dot" style="background: #0044cc;"></span>
                        <span class="preview-dot" style="background: #aa0000;"></span>
                        <span class="preview-dot" style="background: #8c8c8c;"></span>
                    </div>
                    <p class="desc-calidad">5 colores: Negro, Rosado, Azul, Rojo y Gris.</p>
                    <div class="cta-tarjeta">VER COLORES</div>
                </button>
            </div>

            <button class="btn-cerrar-modal-algodon" id="btn-cerrar-modal-algodon">VOLVER AL CARRUSEL</button>
        </div>
    </div>

    <div class="escaparate">
        
        <!-- 1. CARRUSEL HORIZONTAL NORMAL -->
        <div class="swiper mySwiper">
            <div class="indicador-swipe" id="aviso-deslizar">
                ⟷ DESLIZA
            </div>

            <div class="swiper-wrapper">
                <!-- OUTFIT 1 (HOODIES) -->
                <div class="swiper-slide" 
                     data-nombre="HOODIE MURCIÉLAGO" 
                     data-precio="$22.00" 
                     data-desc="Hoodie Boxy Fit en corte murciélago. Disponible en 100% y 65% algodón."
                     data-mockup="/hoddierosa.png"
                     data-tipo="hoodie"
                     data-btn-text="VER MÁS COLORES DE HOODIES">
                    <img src="/outfit1.png" alt="Outfit 1">
                </div>

                <!-- OUTFIT 2 (ZIP HOODIES) -->
