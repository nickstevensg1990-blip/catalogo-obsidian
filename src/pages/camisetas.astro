---
// Lógica de servidor de Astro
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OBSIDIAN STORE</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet">
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #111; 
            overflow-x: hidden;
            font-family: sans-serif;
            margin: 0; 
            transition: background-color 0.5s ease;
        }

        h1 {
            text-align: center;
            margin-top: 40px;
            margin-bottom: 50px;
            font-size: 70px; 
            color: #f7f7f7; 
            letter-spacing: 10px;
            text-transform: uppercase;
            font-family: 'Anton', sans-serif; 
            text-shadow: 4px 4px 20px rgba(0, 0, 0, 0.9);
            position: relative; 
            z-index: 10;
            transition: opacity 0.4s ease;
        }

        .escenario {
            position: relative;
            width: 100%;
            min-height: 100vh; 
            display: flex;
            justify-content: center;
        }

        .video-fondo {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 0;
            filter: grayscale(100%);
            transition: filter 0.5s ease; 
        }

        .overlay-oscuro {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.2); 
            z-index: 1;
            transition: background-color 0.5s ease;
        }

        .barra-perchero {
            position: absolute;
            top: 15px; 
            left: 0;
            width: 100%;
            height: 12px;
            background: linear-gradient(to bottom, #777, #444, #222); 
            box-shadow: 0 12px 25px rgba(0,0,0,0.5); 
            z-index: 2; 
        }

        .contenedor-ropa {
            position: relative;
            z-index: 3; 
            display: flex;
            justify-content: center;
            align-items: flex-start; 
            gap: 0px;
            width: 100%;
            max-width: 1200px;
            padding: 0 20px;
            margin-top: 10px; 
        }

        .prenda-colgada {
            position: relative; 
            width: 280px; 
            margin: 0 -15px; 
            height: 480px; 
            cursor: pointer;
            transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94), filter 0.4s ease, opacity 0.4s ease;
            transform-origin: top center; 
            display: flex;
            justify-content: center;
        }

        .prenda-colgada > img {
            position: absolute; 
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: contain; 
            object-position: top center; 
            filter: drop-shadow(8px 15px 12px rgba(0,0,0,0.35)); 
            transition: opacity 0.3s ease, visibility 0.3s; 
        }

        .etiqueta-nombre {
            position: absolute;
            bottom: 20px; 
            left: 50%;
            transform: translateX(-50%) translateY(15px); 
            background-color: #f7f7f7; 
            color: #111; 
            padding: 8px 16px;
            font-size: 12px;
            font-weight: bold;
            letter-spacing: 2px;
            text-transform: uppercase;
            white-space: nowrap; 
            box-shadow: 0 5px 15px rgba(0,0,0,0.5);
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            pointer-events: none; 
            z-index: 10;
            border-radius: 4px; 
        }

        .prenda-colgada .img-perfil { opacity: 1; visibility: visible; }
        .prenda-colgada .img-frente { opacity: 0; visibility: hidden; }

        body:not(.modo-enfocado) .prenda-colgada:hover {
            transform: rotate(-4deg) scale(1.05);
        }
        body:not(.modo-enfocado) .prenda-colgada:hover .img-perfil { opacity: 0; visibility: hidden; }
        body:not(.modo-enfocado) .prenda-colgada:hover .img-frente { opacity: 1; visibility: visible; }
        body:not(.modo-enfocado) .prenda-colgada:hover .etiqueta-nombre {
            opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0);
        }

        /* =========================================
           MODO ENFOQUE (ZOOM AL DAR CLIC)
           ========================================= */
        
        body.modo-enfocado .video-fondo { filter: grayscale(100%) blur(15px); }
        body.modo-enfocado .overlay-oscuro { background-color: rgba(0, 0, 0, 0.75); }
        body.modo-enfocado h1 { opacity: 0.15; } 
        
        .contenedor-ropa.ropa-enfocada .prenda-colgada:not(.activa) {
            filter: blur(12px) brightness(0.4);
            transform: scale(0.85) translateY(-20px);
            pointer-events: none; 
        }

        .prenda-colgada.activa {
            position: fixed !important;
            top: 50% !important;
            left: 28% !important; 
            transform: translate(-50%, -50%) scale(1.1) !important; 
            z-index: 100;
            margin: 0;
        }
        
        .prenda-colgada.activa .img-perfil { opacity: 0 !important; visibility: hidden !important; }
        .prenda-colgada.activa .img-frente { opacity: 1 !important; visibility: visible !important; }
        .prenda-colgada.activa .etiqueta-nombre { opacity: 0; visibility: hidden; }

        /* =========================================
           PANEL LATERAL Y SCROLL
           ========================================= */
        
        .panel-detalles {
            position: absolute;
            top: 50%;
            right: -450px; 
            transform: translateY(-50%);
            width: 320px;
            max-height: 75vh; 
            overflow-y: auto;
            padding-right: 15px; 
            display: flex;
            flex-direction: column;
            gap: 12px;
            opacity: 0;
            visibility: hidden;
            transition: all 0.4s ease;
            text-align: left;
        }

        .panel-detalles::-webkit-scrollbar { width: 6px; }
        .panel-detalles::-webkit-scrollbar-thumb { background-color: #555; border-radius: 10px; }

        .prenda-colgada.activa .panel-detalles {
            opacity: 1;
            visibility: visible;
            right: -380px; 
        }

        .precio-etiqueta {
            font-family: 'Anton', sans-serif;
            font-size: 38px;
            color: #fff;
            letter-spacing: 2px;
            text-shadow: 2px 2px 15px rgba(0,0,0,0.8);
            margin-bottom: -5px;
        }

        .selector-calidad {
            display: flex;
            gap: 8px;
            margin-bottom: 5px;
        }

        .btn-calidad {
            background: transparent;
            color: #888;
            border: 1px solid #444;
            padding: 6px 10px;
            font-size: 10px;
            font-weight: bold;
            letter-spacing: 1px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
            border-radius: 2px;
        }

        .btn-calidad.activo {
            background: #f7f7f7;
            color: #111;
            border-color: #f7f7f7;
        }

        .btn-calidad:hover:not(.activo) {
            color: #fff;
            border-color: #fff;
        }

        .desc-etiqueta {
            font-size: 13px;
            color: #ddd;
            line-height: 1.5;
            text-shadow: 1px 1px 8px rgba(0,0,0,0.9);
            font-weight: 300;
        }

        .grupo-colores {
            display: none; 
            gap: 12px;
            margin-top: 5px;
            flex-wrap: wrap; 
        }

        .grupo-colores.activo {
            display: flex; 
        }

        .color-tag {
            width: 28px;
            height: 42px; 
            border: 2px solid #fff;
            border-radius: 3px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.6);
            cursor: pointer;
            position: relative;
            transition: transform 0.2s;
        }

        .color-tag:hover {
            transform: scale(1.15) translateY(-5px);
        }

        .color-tag::before {
            content: '';
            position: absolute;
            top: 5px;
            left: 50%;
            transform: translateX(-50%);
            width: 5px;
            height: 5px;
            background-color: #111;
            border-radius: 50%;
        }

        /* --- GALERÍA DE MODELOS --- */
        .seccion-modelos {
            display: none; 
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #333;
            flex-direction: column;
            gap: 15px;
        }

        .seccion-modelos.activo {
            display: flex;
        }

        .titulo-modelos {
            font-family: 'Anton', sans-serif;
            color: #fff;
            font-size: 18px;
            letter-spacing: 2px;
            margin-bottom: -5px;
        }

        .img-modelo {
            position: relative;
            width: 100%;
            height: auto; 
            border-radius: 4px;
            object-fit: cover;
            box-shadow: 0 5px 15px rgba(0,0,0,0.6);
            border: 1px solid #222;
        }

        /* =========================================
           RESPONSIVE (MÓVILES Y PANTALLAS PEQUEÑAS)
           ========================================= */
        @media (max-width: 768px) {
            h1 {
                font-size: 40px;
                margin-top: 20px;
                margin-bottom: 30px;
            }

            .prenda-colgada.activa {
                left: 50% !important;
                top: 35% !important; 
                transform: translate(-50%, -50%) scale(0.85) !important; 
            }

            .panel-detalles, .prenda-colgada.activa .panel-detalles {
                top: 100%;
                left: 50%;
                right: auto;
                transform: translateX(-50%); 
                width: 90vw; 
                max-width: 320px;
                padding-right: 0;
                padding-top: 30px; 
                max-height: 55vh; 
                text-align: center; 
                align-items: center; 
            }

            .selector-calidad, .grupo-colores {
                justify-content: center;
            }
        }
    </style>
</head>
<body>

    <h1>OBSIDIAN</h1>

    <div class="escenario">
        
        <video autoplay loop muted playsinline class="video-fondo">
            <source src="/tren-movimiento.mp4" type="video/mp4">
        </video>
        
        <div class="overlay-oscuro"></div>

        <div class="barra-perchero"></div>

        <div class="contenedor-ropa">
            
            <!-- HOODIE MURCIELAGO -->
            <div class="prenda-colgada">
                <img src="/hoddie2.png" alt="Hoodie Perfil" class="img-perfil">
                <img src="/hoodie2-frente.png" alt="Hoodie Frente" class="img-frente">
                <div class="etiqueta-nombre">HODDIE BOXY FIT MURCIELAGO</div>
                
                <div class="panel-detalles">
                    <div class="precio-etiqueta">$22.00</div>
                    
                    <div class="selector-calidad">
                        <button class="btn-calidad activo" data-target="grupo-100">100% ALGODÓN</button>
                        <button class="btn-calidad" data-target="grupo-65">65% ALGODÓN</button>
                    </div>

                    <p class="desc-etiqueta">Hoodie Gris boxy fit en corte murciélago 100% algodón.</p>
                    
                    <!-- COLORES 100% ALGODON -->
                    <div class="grupo-colores activo" id="grupo-100">
                        <div class="color-tag" data-img="/hoodie2-frente.png" data-precio="$22.00" data-desc="Hoodie Gris boxy fit en corte murciélago 100% algodón." style="background-color: #b3b3b3;" title="Gris"></div>
                        <div class="color-tag" data-img="/hoodie-vino.png" data-precio="$22.00" data-desc="Hoodie Vino boxy fit en corte murciélago 100% algodón." style="background-color: #4a0404;" title="Vino"></div>
                    </div>

                    <!-- COLORES 65% ALGODON -->
                    <div class="grupo-colores" id="grupo-65">
                        <div class="color-tag" data-img="/negra.png" data-precio="$17.00" data-desc="Hoodie Negro boxy fit en corte murciélago 65% algodón." data-lookbook="true" style="background-color: #1a1a1a;" title="Negro"></div>
                        <div class="color-tag" data-img="/hoodie-rojo.png" data-precio="$17.00" data-desc="Hoodie Rojo boxy fit en corte murciélago 65% algodón." style="background-color: #aa0000;" title="Rojo"></div>
                        <div class="color-tag" data-img="/hoodie-gris65.png" data-precio="$17.00" data-desc="Hoodie Gris boxy fit en corte murciélago 65% algodón." style="background-color: #8c8c8c;" title="Gris"></div>
                        <div class="color-tag" data-img="/hoodie-rosado.png" data-precio="$17.00" data-desc="Hoodie Rosado boxy fit en corte murciélago 65% algodón." style="background-color: #eebbce;" title="Rosado"></div>
                        <div class="color-tag" data-img="/hoodie-crema.png" data-precio="$17.00" data-desc="Hoodie Crema boxy fit en corte murciélago 65% algodón." style="background-color: #f5f5dc;" title="Crema"></div>
                    </div>

                    <!-- GALERÍA DE MODELOS -->
                    <div class="seccion-modelos" id="lookbook-murcielago">
                        <h3 class="titulo-modelos">LOOKBOOK</h3>
                        <p class="desc-etiqueta" style="margin-top: -10px; font-size: 11px;">Así se ve puesto en nuestros modelos.</p>
                        <img src="/77.jpeg" alt="Modelo 1" class="img-modelo">
                        <img src="/66.jpeg" alt="Modelo 2" class="img-modelo">
                    </div>

                </div>
            </div>

            <!-- APEX TEE -->
            <div class="prenda-colgada">
                <img src="/Camiseta2.png" alt="Camiseta Perfil" class="img-perfil">
                <img src="/camiseta2-frente.png" alt="Camiseta Frente" class="img-frente">
                <div class="etiqueta-nombre">APEX TEE BOXY FIT</div>
            </div>

            <div class="prenda-colgada">
                <img src="/blanca2.png" alt="Camiseta Blanca Perfil" class="img-perfil">
                <img src="/blanca2-frente.png" alt="Camiseta Blanca Frente" class="img-frente">
                <div class="etiqueta-nombre">CAMISETA BOXY FIT</div>
            </div>

            <div class="prenda-colgada">
                <img src="/slong2.png" alt="Manga Larga Perfil" class="img-perfil">
                <img src="/slong2-frente.png" alt="Manga Larga Frente" class="img-frente">
                <div class="etiqueta-nombre">SLONG SLEEVE</div>
            </div>

        </div>
    </div>

    <script>
        const prendas = document.querySelectorAll('.prenda-colgada');
        const contenedor = document.querySelector('.contenedor-ropa');
        const body = document.body;

        prendas.forEach(prenda => {
            prenda.addEventListener('click', () => {
                if (prenda.classList.contains('activa')) {
                    prenda.classList.remove('activa');
                    contenedor.classList.remove('ropa-enfocada');
                    body.classList.remove('modo-enfocado');
                    
                    const panel = prenda.querySelector('.panel-detalles');
                    if (panel) panel.scrollTop = 0;
                } else {
                    prendas.forEach(p => {
                        p.classList.remove('activa');
                        const pPanel = p.querySelector('.panel-detalles');
                        if (pPanel) pPanel.scrollTop = 0;
                    });
                    prenda.classList.add('activa');
                    contenedor.classList.add('ropa-enfocada');
                    body.classList.add('modo-enfocado');
                }
            });
        });

        const botonesCalidad = document.querySelectorAll('.btn-calidad');
        botonesCalidad.forEach(boton => {
            boton.addEventListener('click', (e) => {
                e.stopPropagation(); 
                
                if(boton.classList.contains('activo')) return;

                const panelDetalles = boton.closest('.panel-detalles');
                
                const botonesHermanos = panelDetalles.querySelectorAll('.btn-calidad');
                botonesHermanos.forEach(b => b.classList.remove('activo'));
                boton.classList.add('activo');

                const gruposColores = panelDetalles.querySelectorAll('.grupo-colores');
                gruposColores.forEach(grupo => grupo.classList.remove('activo'));

                const targetId = boton.getAttribute('data-target');
                const grupoObjetivo = panelDetalles.querySelector(`#${targetId}`);
                if(grupoObjetivo) {
                    grupoObjetivo.classList.add('activo');
                    
                    const primerColor = grupoObjetivo.querySelector('.color-tag');
                    if(primerColor) {
                        primerColor.click();
                    }
                }
            });
        });

        const colores = document.querySelectorAll('.color-tag');
        colores.forEach(tag => {
            tag.addEventListener('click', (e) => {
                e.stopPropagation(); 
                
                const nuevaImg = tag.getAttribute('data-img');
                const nuevaDesc = tag.getAttribute('data-desc');
                const nuevoPrecio = tag.getAttribute('data-precio');
                const mostrarLookbook = tag.getAttribute('data-lookbook'); 
                
                const prendaPadre = tag.closest('.prenda-colgada');
                const panelDetalles = prendaPadre.querySelector('.panel-detalles');
                
                prendaPadre.querySelector('.img-frente').src = nuevaImg;
                
                const textoDescripcion = prendaPadre.querySelector('.desc-etiqueta');
                if (textoDescripcion && nuevaDesc) {
                    textoDescripcion.innerText = nuevaDesc;
                }

                const textoPrecio = prendaPadre.querySelector('.precio-etiqueta');
                if (textoPrecio && nuevoPrecio) {
                    textoPrecio.innerText = nuevoPrecio;
                }
                
                const seccionModelos = prendaPadre.querySelector('.seccion-modelos');
                if (seccionModelos) {
                    if (mostrarLookbook === 'true') {
                        seccionModelos.classList.add('activo');
                    } else {
                        seccionModelos.classList.remove('activo');
                    }
                }
                
                if (panelDetalles) {
                    panelDetalles.scrollTop = 0;
                }
            });
        });
    </script>

</body>
</html>