---
// Lógica de servidor de Astro
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OBSIDIAN STORE - LOOKS</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet">
    
    <!-- Librería CSS de Swiper -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body {
            background-color: #000000; 
            font-family: sans-serif;
            overflow: hidden; 
            color: #f7f7f7; 
        }

        .video-fondo {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            object-fit: cover;
            z-index: 0; 
        }

        .overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.4); 
            z-index: 1; 
        }

        .escaparate {
            position: relative; 
            z-index: 10; 
            display: flex;
            align-items: center; 
            justify-content: space-between; 
            height: 100vh; 
            width: 100%;
            max-width: 1700px; 
            margin: 0 auto;
            padding: 0 50px; 
            gap: 40px;
        }

        /* ================================
           ZONA IZQUIERDA: CARRUSEL
           ================================ */
        .swiper {
            width: 75%; 
            height: 85vh; 
            padding: 0; 
        }
        
        .swiper-slide {
            width: 500px; 
            height: 100%; 
            display: flex;
            justify-content: center;
            align-items: flex-end; 
            
            opacity: 1 !important; 
            transform: scale(0.75); 
            transform-origin: bottom center; 
            transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.4s ease; 
        }
        
        .swiper-slide-active {
            transform: scale(1); 
            z-index: 10; 
        }

        body.modo-colores .swiper-slide:not(.swiper-slide-active) {
            opacity: 0 !important;
            pointer-events: none;
        }
        
        .swiper-slide img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: contain;
            object-position: bottom; 
            filter: drop-shadow(0px 25px 20px rgba(0,0,0,0.8));
            transition: opacity 0.3s ease; 
        }

        /* ================================
           ZONA DERECHA: PANEL DE COMPRA
           ================================ */
        .panel-lateral {
            width: 25%; 
            max-width: 350px;
            flex-shrink: 0; 
            background: rgba(15, 15, 15, 0.6); 
            backdrop-filter: blur(8px); 
            border: 1px solid rgba(255, 255, 255, 0.1); 
            padding: 30px; 
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8); 
        }

        .vista-principal { display: flex; flex-direction: column; gap: 12px; }
        .vista-colores { display: none; flex-direction: column; gap: 12px; }
        
        body.modo-colores .vista-principal { display: none; }
        body.modo-colores .vista-colores { display: flex; }
        
        .panel-encabezado { margin-bottom: 0px; }

        .etiqueta-in-look {
            font-size: 12px;
            color: #aaa; 
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 5px;
            display: block;
        }

        .nombre-outfit {
            font-family: 'Anton', sans-serif;
            font-size: 28px; 
            color: #fff; 
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 2px;
            line-height: 1.1;
        }
        
        .precio-outfit {
            font-size: 24px;
            font-family: 'Anton', sans-serif;
            color: #f7f7f7; 
            letter-spacing: 1px;
        }

        /* ================================
           CAJA DEL MOCKUP (FONDO BLANCO FORZADO)
           ================================ */
        .contenedor-mockup {
            width: 100%;
            height: 180px; 
            /* AQUÍ FORZAMOS EL BLANCO ABSOLUTO IGNORANDO OTRAS REGLAS */
            background-color: #ffffff !important; 
            border-radius: 8px;
            padding: 15px;
            display: flex; 
            justify-content: center;
            align-items: center;
            margin-bottom: 5px;
            overflow: hidden; 
        }
        
        .contenedor-mockup img {
            width: 100%;
            height: 100%; 
            object-fit: contain; 
            filter: drop-shadow(0px 5px 8px rgba(0,0,0,0.3));
            transition: opacity 0.2s ease;
        }
        
        .desc-outfit {
            font-size: 15px;
            color: #ddd; 
            line-height: 1.5;
            font-weight: 300;
        }

        /* ================================
           BOTONES Y SELECTOR
           ================================ */
        .btn-comprar {
            margin-top: 10px;
            background: #f7f7f7; 
            color: #111; 
            border: none;
            padding: 16px;
            font-family: 'Anton', sans-serif;
            font-size: 18px;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.3s ease;
            border-radius: 4px;
            text-align: center;
            text-decoration: none;
        }
        .btn-comprar:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(255, 255, 255, 0.2); }

        .btn-secundario {
            background: rgba(0, 0, 0, 0.5); 
            color: #f7f7f7; 
            border: 1px solid #555;
            padding: 14px;
            font-family: 'Anton', sans-serif;
            font-size: 14px;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.3s ease;
            border-radius: 4px;
            text-align: center;
            text-decoration: none;
        }
        .btn-secundario:hover { background: #333; border-color: #f7f7f7; }

        .selector-colores {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin: 10px 0;
            flex-wrap: wrap;
        }

        .color-btn {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            border: 2px solid #444;
            cursor: pointer;
            transition: transform 0.2s, border-color 0.2s;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
        }
        .color-btn:hover, .color-btn.activo {
            transform: scale(1.2);
            border-color: #111; 
        }

        /* ================================
           MÓVILES
           ================================ */
        @media (max-width: 900px) {
            body { overflow-y: auto; }
            .escaparate { flex-direction: column; height: auto; padding: 40px 20px; }
            .swiper { width: 100%; height: 60vh; }
            .swiper-slide { width: 320px; }
            .panel-lateral { width: 100%; max-width: 400px; }
        }
    </style>
</head>
<body>

    <video autoplay loop muted playsinline class="video-fondo">
        <source src="/estrellas.mp4" type="video/mp4">
    </video>
    <div class="overlay"></div>

    <div class="escaparate">
        
        <div class="swiper mySwiper">
            <div class="swiper-wrapper">
                
                <!-- OUTFIT 1 -->
                <div class="swiper-slide" 
                     data-nombre="HOODIE MURCIÉLAGO" 
                     data-precio="$22.00" 
                     data-desc="Hoodie Boxy Fit en corte murciélago 100% algodón."
                     data-mockup="/hoddierosa.png"
                     data-has-colors="false">
                    <img src="/outfit1.png" alt="Outfit 1">
                </div>

                <!-- OUTFIT 2 (TIENE LA OPCIÓN DE COLORES Y MODELOS) -->
                <div class="swiper-slide" 
                     data-nombre="ZIP HOODIE MURCIÉLAGO" 
                     data-precio="$17.00" 
                     data-desc="Zip hoodie corte murciélago boxy fit gris."
                     data-mockup="/zip-gris.png"
                     data-has-colors="true">
                    <img src="/outfit2.png" alt="Outfit 2">
                </div>

                <!-- OUTFIT 3 -->
                <div class="swiper-slide" 
                     data-nombre="LOOK APEX" 
                     data-precio="$40.00" 
                     data-desc="Apex Tee Boxy Fit sobre Slong Sleeve base, completando con estilo urbano."
                     data-mockup=""
                     data-has-colors="false">
                    <img src="/outfit3.png" alt="Outfit 3">
                </div>
                
            </div>
        </div>

        <div class="panel-lateral">
            
            <div class="vista-principal" id="vista-principal">
                <div class="panel-encabezado">
                    <span class="etiqueta-in-look">En este Look:</span>
                    <div class="nombre-outfit" id="panel-nombre">CARGANDO...</div>
                    <div class="precio-outfit" id="panel-precio">--</div>
                </div>
                
                <!-- AQUÍ SE APLICA EL FONDO BLANCO -->
                <div class="contenedor-mockup" id="panel-mockup-container" style="display: none;">
                    <img src="" id="panel-mockup" alt="Prenda destacada">
                </div>

                <p class="desc-outfit" id="panel-desc">--</p>
                
                <a href="#" class="btn-comprar">COMPRAR LOOK</a>
                <button id="btn-abrir-colores" class="btn-secundario" style="display: none;">VER MÁS COLORES DE ZIP HOODIES</button>
            </div>

            <div class="vista-colores" id="vista-colores">
                <div class="panel-encabezado">
                    <span class="etiqueta-in-look">Personalizar Prenda:</span>
                    <div class="nombre-outfit">ESCOGER COLOR</div>
                </div>
                
                <!-- AQUÍ TAMBIÉN SE APLICA EL FONDO BLANCO -->
                <div class="contenedor-mockup">
                    <img src="/zip-gris.png" id="mockup-color-preview" alt="Color Preview">
                </div>

                <div class="selector-colores">
                    <button class="color-btn" style="background-color: #1a1a1a;" title="Negro" data-img="/zip-negra.png" data-modelo="/negra8.png"></button>
                    <button class="color-btn" style="background-color: #eebbce;" title="Rosado" data-img="/zip-rosa.png" data-modelo="/outfit2.png"></button>
                    <button class="color-btn" style="background-color: #0044cc;" title="Azul Eléctrico" data-img="/zip-azul.png" data-modelo="/outfit2.png"></button>
                    <button class="color-btn" style="background-color: #aa0000;" title="Rojo" data-img="/zip-rojo.png" data-modelo="/outfit2.png"></button>
                    <button class="color-btn activo" style="background-color: #8c8c8c;" title="Gris" data-img="/zip-gris.png" data-modelo="/outfit2.png"></button>
                </div>

                <a href="#" class="btn-comprar">COMPRAR ESTE COLOR</a>
                <button id="btn-cerrar-colores" class="btn-secundario">VOLVER AL CARRUSEL</button>
            </div>

        </div>

    </div>

    <script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    
    <script is:inline>
        const swiper = new Swiper(".mySwiper", {
            grabCursor: true,      
            centeredSlides: true,  
            slidesPerView: "auto", 
            loop: false,             
            spaceBetween: 10,        
            speed: 600,              
            on: {
                init: function () {
                    actualizarPanelDeCompras(this);
                },
                slideChange: function () {
                    actualizarPanelDeCompras(this);
                }
            }
        });

        function actualizarPanelDeCompras(swiperInstance) {
            const slideActivo = swiperInstance.slides[swiperInstance.activeIndex];
            if (!slideActivo) return;

            const nombre = slideActivo.getAttribute('data-nombre') || '';
            const precio = slideActivo.getAttribute('data-precio') || '';
            const desc = slideActivo.getAttribute('data-desc') || '';
            const mockup = slideActivo.getAttribute('data-mockup') || ''; 
            const hasColors = slideActivo.getAttribute('data-has-colors') === 'true';

            document.getElementById('panel-nombre').innerText = nombre;
            document.getElementById('panel-precio').innerText = precio;
            document.getElementById('panel-desc').innerText = desc;

            const mockupContainer = document.getElementById('panel-mockup-container');
            const mockupImg = document.getElementById('panel-mockup');
            const btnAbrirColores = document.getElementById('btn-abrir-colores');

            if (mockup.trim() !== "") {
                mockupImg.src = mockup;
                mockupContainer.style.display = 'flex'; 
            } else {
                mockupImg.src = "";
                mockupContainer.style.display = 'none'; 
            }

            if (hasColors) {
                btnAbrirColores.style.display = 'block';
                document.getElementById('mockup-color-preview').src = mockup; 
            } else {
                btnAbrirColores.style.display = 'none';
            }
        }

        document.getElementById('btn-abrir-colores').addEventListener('click', (e) => {
            e.preventDefault();
            document.body.classList.add('modo-colores');
            swiper.allowTouchMove = false; 
        });

        document.getElementById('btn-cerrar-colores').addEventListener('click', (e) => {
            e.preventDefault();
            document.body.classList.remove('modo-colores');
            swiper.allowTouchMove = true; 
        });

        const botonesColor = document.querySelectorAll('.color-btn');
        const imgPreview = document.getElementById('mockup-color-preview');

        botonesColor.forEach(btn => {
            btn.addEventListener('click', (e) => {
                
                botonesColor.forEach(b => b.classList.remove('activo'));
                e.target.classList.add('activo');
                
                const nuevaImg = e.target.getAttribute('data-img');
                const nuevoModelo = e.target.getAttribute('data-modelo'); 
                
                const slideActivo = document.querySelector('.swiper-slide-active');
                const imgModeloGigante = slideActivo.querySelector('img');
                
                slideActivo.setAttribute('data-mockup', nuevaImg);

                imgPreview.style.opacity = 0;
                setTimeout(() => {
                    imgPreview.src = nuevaImg;
                    imgPreview.style.opacity = 1;
                }, 200);

                if(imgModeloGigante && nuevoModelo) {
                    imgModeloGigante.style.opacity = 0;
                    setTimeout(() => {
                        imgModeloGigante.src = nuevoModelo;
                        imgModeloGigante.style.opacity = 1;
                    }, 200);
                }
            });
        });
    </script>
</body>
</html>